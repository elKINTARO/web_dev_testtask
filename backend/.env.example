# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=drone_delivery

# Database connection
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@localhost:5432/drone_delivery
DB_ECHO=false

# Nominatim reverse geocoding
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=DroneDeliveryApp/1.0
NOMINATIM_TIMEOUT=10.0

# Tax rates file path (absolute, or leave empty to use default backend/tax_rates.json)
# TAX_RATES_PATH=/absolute/path/to/tax_rates.json

# Pagination
DEFAULT_LIMIT=20
MAX_LIMIT=100

# File upload
MAX_UPLOAD_SIZE_MB=10

# PostgreSQL container credentials (used by docker-compose only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=drone_delivery
